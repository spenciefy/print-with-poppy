# demo makes no external purchases or email sends. sandbox uses real test providers.
APP_MODE=demo
PORT=8787
PUBLIC_URL=http://localhost:5173
DATA_DIR=.data
# Required for sandbox/live: at least 32 random characters
APP_SECRET=
PRODIGI_API_KEY=
PRODIGI_FINISH=lustre
PRODIGI_SHIPPING_METHOD=Budget
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Print with Poppy <orders@printwithpoppy.com>
SUPPORT_EMAIL=hello@printwithpoppy.com
# Comma-separated HTTPS client metadata URLs accepted for production sessions
AGENT_CLIENT_IDS=
# Retail = provider item cost * multiplier + shipping; supplier tax is absorbed in margin
# Optional honest transit estimate; unset means no arrival estimate promised

# Allow agents with ordinary HTTP tools to use isolated guest Bearer sessions.
ALLOW_COMPAT_AGENT_SESSIONS=false
